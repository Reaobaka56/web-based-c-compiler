{
  "redirects": [
    {
      "source": "/:path((?!api/|assets/|demo/|toolchain/)[^.]*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "https://:project.vercel.app/:path*",
      "destination": "https://<MY_DOMAIN>/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
